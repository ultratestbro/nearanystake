# Everything is optional: the app runs locally with no environment at all. Quotes come from the public
# 1Click API in the browser, NEAR reads from public RPC nodes through /api/rpc/near.
# Keep overrides commented out unless you set them: an empty value is not the same as an unset one.

# Reown (WalletConnect) project id: EVM and Solana wallets in the "Pay with" step. Without it, EVM falls
# back to the browser's injected wallet and every chain can still be paid by hand to the deposit address.
# NEXT_PUBLIC_REOWN_PROJECT_ID=

# NEAR RPC nodes the server-side proxy fails over between (comma-separated, view calls only)
# NEAR_RPC_URLS=https://free.rpc.fastnear.com,https://rpc.mainnet.fastnear.com,https://near.drpc.org
# NEAR node the browser falls back to when the proxy is down
# NEXT_PUBLIC_NEAR_RPC_URL=https://free.rpc.fastnear.com

# 1Click API base URL (defaults to the public one, no key: 0.2 % 1Click fee)
# NEXT_PUBLIC_ONE_CLICK_API_URL=https://1click.chaindefuser.com/v0

# The read-only demo account on /portfolio (a public delegator with NEAR unbonding) and the default pool
# NEXT_PUBLIC_DEMO_ACCOUNT=nima.near
# NEXT_PUBLIC_SUGGESTED_POOL=astro-stakers.poolv1.near

# Nodes for Solana and TON deposit builders (public endpoints otherwise)
# SOLANA_RPC_URL=
# TON_RPC_URL=

# Public site URL for the TON Connect manifest (defaults to the request origin)
# PUBLIC_URL=
